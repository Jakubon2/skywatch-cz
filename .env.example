# Copy to .env and fill in. Never commit .env.

# Claude API (phase 2+)
ANTHROPIC_API_KEY=

# Optional: adsb.lol may require an API key in the future (sent as "api-auth" header)
ADSB_API_KEY=

# ntfy.sh topic for alerts (phase 4)
NTFY_TOPIC=

# Deployment (docker compose + Caddy, see docs/deploy.md). Not needed for local development.
# Domain whose DNS A/AAAA record points at the VPS; Caddy gets the HTTPS certificate for it.
DOMAIN=
# Shared access token for the app (login page, cookie, or "Authorization: Bearer"). Generate: openssl rand -hex 32
SKYWATCH_TOKEN=

# Contact URL or e-mail for the User-Agent (required by planespotters.net photo API)
SKYWATCH_CONTACT=

# Web Push to the installed PWA (alongside ntfy). Generate: cd backend && .venv/bin/python vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, mailto: or https:
VAPID_SUBJECT=

# Optional: openAIP API key (https://www.openaip.net, account > API). Without it the airspace layer uses openAIP's public export.
OPENAIP_API_KEY=

# Contact e-mail or URL sent in the User-Agent (planespotters.net requires one for photos)
SKYWATCH_CONTACT=
