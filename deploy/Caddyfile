# skywatch-cz: Caddy serves the built frontend (/srv) and proxies /api to the backend.
# HTTPS is automatic (Let's Encrypt) as soon as DNS for {$DOMAIN} points at this server.
#
# Access: shared token from .env (SKYWATCH_TOKEN), kept in an HttpOnly cookie for a year.
# First visit shows a small login page; the token is typed once, also inside an installed PWA.
# Scripts/curl can send "Authorization: Bearer <token>" instead. See docs/deploy.md.

{$DOMAIN} {
	# gzip/zstd for everything except the SSE stream (compression must not hold events back).
	@compressible not path /api/stream
	encode @compressible zstd gzip

	header -Server

	# route = handlers run strictly in the order written.
	route {
		# Login: /login?token=... sets the cookie and redirects home. Only the correct token matches.
		@login {
			path /login
			query token={$SKYWATCH_TOKEN}
		}
		handle @login {
			header Set-Cookie "skywatch_token={$SKYWATCH_TOKEN}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax"
			header Cache-Control no-store
			redir * / 303
		}

		# Everything needs the token, except PWA metadata that browsers fetch without cookies
		# (the manifest and its icons are requested with credentials "omit").
		@denied {
			not path /manifest.webmanifest /sw.js /favicon.svg /icons/*
			not header Cookie *skywatch_token={$SKYWATCH_TOKEN}*
			not header Authorization "Bearer {$SKYWATCH_TOKEN}"
		}
		handle @denied {
			header Cache-Control no-store
			handle /api/* {
				respond "Nepřihlášeno" 401
			}
			handle {
				header Content-Type "text/html; charset=utf-8"
				respond <<HTML
					<!doctype html>
					<html lang="cs">
					<head>
					<meta charset="utf-8">
					<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
					<meta name="color-scheme" content="light dark">
					<title>Skywatch CZ – přihlášení</title>
					<style>
					body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 16px/1.4 system-ui, sans-serif; background: Canvas; color: CanvasText; }
					form { width: min(22rem, calc(100vw - 2rem)); display: grid; gap: .75rem; }
					h1 { font-size: 1.25rem; margin: 0; }
					input, button { font: inherit; padding: .7rem .8rem; border-radius: .5rem; border: 1px solid GrayText; }
					button { background: #2563eb; color: #fff; border: 0; }
					p { margin: 0; color: GrayText; font-size: .9rem; }
					#bad { color: #dc2626; display: none; }
					</style>
					</head>
					<body>
					<form method="get" action="/login">
					<h1>Skywatch CZ</h1>
					<p>Soukromá aplikace. Zadej přístupový token.</p>
					<input type="text" name="username" value="skywatch" autocomplete="username" hidden>
					<input type="password" name="token" placeholder="Token" autocomplete="current-password" required autofocus>
					<button type="submit">Přihlásit</button>
					<p id="bad">Token nesedí, zkus to znovu.</p>
					</form>
					<script>
					if (location.pathname === "/login") { document.getElementById("bad").style.display = "block"; history.replaceState(null, "", "/"); }
					</script>
					</body>
					</html>
					HTML 401
			}
		}

		# API, including the SSE stream /api/stream: flush every write immediately, no buffering.
		handle /api/* {
			reverse_proxy backend:8000 {
				flush_interval -1
			}
		}

		# Built frontend (SPA).
		handle {
			root * /srv
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			header /sw.js Cache-Control no-cache
			header /manifest.webmanifest Content-Type application/manifest+json
			@shell path / /index.html
			header @shell Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
